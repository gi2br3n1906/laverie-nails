# Install at /etc/cron.d/laverie-scheduler.
# Create /var/log/laverie first and make it writable by www-data.
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
* * * * * www-data cd /var/www/laverie && /usr/bin/php artisan schedule:run >> /var/log/laverie/scheduler.log 2>&1
