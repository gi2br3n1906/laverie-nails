[Unit]
Description=Laverie Nails Queue Worker
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/laverie
Restart=always
RestartSec=5
ExecStart=/usr/bin/php /var/www/laverie/artisan queue:work --sleep=3 --tries=3 --max-time=3600

[Install]
WantedBy=multi-user.target
