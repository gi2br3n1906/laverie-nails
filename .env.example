APP_NAME="Laverie Nails"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_PORT=8080
APP_IMAGE_TAG=latest
APP_TIMEZONE=Asia/Jakarta

# Comma-separated proxy IPs, or "*" only when the origin port is bound to
# 127.0.0.1 and reachable exclusively through Cloudflare Tunnel / a load balancer.
# Required behind a tunnel so Laravel sees the real client IP and HTTPS scheme.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_BUSY_TIMEOUT=5000
DB_JOURNAL_MODE=WAL
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production (HTTPS via Cloudflare Tunnel); required for secure cookies.
SESSION_SECURE_COOKIE=
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local development writes mail to storage/logs/laravel.log.
# Production (Brevo transactional SMTP) should use:
#   MAIL_MAILER=smtp
#   MAIL_SCHEME=null        (port 587 + STARTTLS; use "smtps" only with port 465)
#   MAIL_HOST=smtp-relay.brevo.com
#   MAIL_PORT=587
#   MAIL_USERNAME=<SMTP login from Brevo's SMTP settings page, often <id>@smtp-brevo.com; not always the account email>
#   MAIL_PASSWORD=<Brevo SMTP key starting with xsmtpsib-, NOT an API key or the account password>
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="admin@laverie.web.id"
MAIL_FROM_NAME="${APP_NAME}"

LAVERIE_WHATSAPP_NUMBER=6280000000000
LAVERIE_INSTAGRAM_URL=https://www.instagram.com/
LAVERIE_TIKTOK_URL=https://www.tiktok.com/

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Local checkout testing: use keys from the Sandbox environment in Midtrans Dashboard > Settings > Access Keys.
# Put the actual keys in the root .env file, not this tracked example; keep Server Key private.
# Sandbox keys and URLs here must stay paired. Production uses separate keys and URLs:
#   MIDTRANS_IS_PRODUCTION=true
#   MIDTRANS_SNAP_URL=https://app.midtrans.com/snap/v1/transactions
#   MIDTRANS_SNAP_JS_URL=https://app.midtrans.com/snap/snap.js
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/v1/transactions
MIDTRANS_SNAP_JS_URL=https://app.sandbox.midtrans.com/snap/snap.js
MIDTRANS_API_URL=https://api.sandbox.midtrans.com/v2

# Server-side proxy for Indonesian region data (province/regency/district/village).
WILAYAH_API_URL=https://wilayah.id/api
WILAYAH_API_TIMEOUT=8

# Google OAuth (login with Google). Create these in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
