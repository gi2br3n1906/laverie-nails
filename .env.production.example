# Production environment for the Docker stack behind Cloudflare Tunnel.
# Copy to .env on the VPS, fill the blank secrets, then run ./deploy.sh.
# Never commit the filled .env file.

APP_NAME="Laverie Nails"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://laverie.web.id
APP_PORT=8080
APP_IMAGE_TAG=latest
APP_TIMEZONE=Asia/Jakarta

# The compose port is bound to 127.0.0.1 only. "*" is safe only while the
# origin is reachable exclusively through the tunnel. Use explicit IPs/CIDRs
# if you ever expose the origin through a known load balancer instead.
TRUSTED_PROXIES=*

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=sqlite
DB_DATABASE=/var/www/data/database.sqlite
DB_BUSY_TIMEOUT=5000
DB_JOURNAL_MODE=WAL

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Brevo transactional SMTP. MAIL_USERNAME is the SMTP "Login" value, often
# <id>@smtp-brevo.com; MAIL_PASSWORD is the xsmtpsib-... SMTP key.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=admin@laverie.web.id
MAIL_FROM_NAME="Laverie Nails"

LAVERIE_WHATSAPP_NUMBER=6280000000000
LAVERIE_INSTAGRAM_URL=https://www.instagram.com/
LAVERIE_TIKTOK_URL=https://www.tiktok.com/

VITE_APP_NAME="${APP_NAME}"

# Live Midtrans keys. Server Key stays server-side only.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=true
MIDTRANS_SNAP_URL=https://app.midtrans.com/snap/v1/transactions
MIDTRANS_SNAP_JS_URL=https://app.midtrans.com/snap/snap.js

# Server-side proxy for Indonesian region data (province/regency/district/village).
WILAYAH_API_URL=https://wilayah.id/api
WILAYAH_API_TIMEOUT=8

# Google OAuth (login with Google). Create these in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://laverie.web.id/auth/google/callback
